{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"jsx": "preserve",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "node"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["resources/**/*.ts", "resources/**/*.vue", "vite.config.ts"]
}
