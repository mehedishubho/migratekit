{
	"name": "wpmhs/migratekit",
	"description": "MigrateKit — WordPress migration, backup and restore. Every feature included, free, forever.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"keywords": ["wordpress", "migration", "backup", "restore", "wpress"],
	"homepage": "https://getMigrateKit.com",
	"authors": [
		{
			"name": "MEHEDI HASSAN SHUBHO",
			"homepage": "https://wpmhs.com"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"phpstan/phpstan": "^1.11",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/php-compatibility": "^9.3"
	},
	"autoload": {
		"psr-4": {
			"MigrateKit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MigrateKit\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "7.4.33"
		}
	},
	"scripts": {
		"test": "phpunit",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"phpcs": "phpcs"
	},
	"scripts-descriptions": {
		"test": "Run the PHPUnit test suite.",
		"phpstan": "Run static analysis.",
		"phpcs": "Run WordPress coding standards checks."
	}
}
